{
    "description": "Swap Ctrl and Alt for Backspace",
    "manipulators": [
        {
            "conditions": [
                {
                    "bundle_identifiers": [
                        "^com\\.apple\\.finder$"
                    ],
                    "type": "frontmost_application_unless"
                }
            ],
            "from": {
                "key_code": "delete_or_backspace",
                "modifiers": { "mandatory": ["command"] }
            },
            "to": [
                {
                    "key_code": "delete_or_backspace",
                    "modifiers": ["option"]
                }
            ],
            "type": "basic"
        },
        {
            "from": {
                "key_code": "delete_or_backspace",
                "modifiers": { "mandatory": ["option"] }
            },
            "to": [
                {
                    "key_code": "left_arrow",
                    "modifiers": ["command", "shift"]
                },
                { "key_code": "delete_or_backspace" }
            ],
            "type": "basic"
        }
    ]
}
